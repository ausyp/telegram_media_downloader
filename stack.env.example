# Telegram Media Downloader settings. Copy to .env (docker compose) or load it in
# Portainer: Stacks > Add stack > Environment variables > "Load variables from .env file".
# Lines starting with # are ignored. Leave optional values empty to use the default.

# REQUIRED - from https://my.telegram.org/apps (API development tools)
API_ID=
API_HASH=

# Bot token from @BotFather (/newbot). Everything you send to the bot gets downloaded.
BOT_TOKEN=

# Password for the web UI on port 5000. Leave empty for no password (not recommended).
WEB_LOGIN_SECRET=

# Folder on the server where downloads are saved, e.g. /mnt/media/telegram
# Empty = a Docker volume named tmd_downloads
DOWNLOAD_PATH=

# Who can use the bot: comma separated user ids or @usernames. "me" = your own account.
ALLOWED_USER_IDS=me

# Number of files downloaded at the same time
MAX_DOWNLOAD_TASK=5

# Optional: chats/channels to fully download on every start, comma separated
# e.g. -1001234567890,-1009876543210 (get ids from @username_to_id_bot)
CHAT_IDS=

# Subfolders inside DOWNLOAD_PATH, comma separated, in order: chat_title, media_datetime
# (year_month, e.g. 2026_10), media_type. "none" saves every file directly in DOWNLOAD_PATH.
# Example: chat_title,media_datetime gives <chat name>/2026_10/<file>.
FILE_PATH_PREFIX=none

# How files are named, comma separated parts in order: message_id, file_name, caption.
# Default "message_id,file_name" gives "1970 - Movie.mkv". Use "file_name" to keep the
# original name only (a second file with the same name in the same folder is then skipped).
FILE_NAME_PREFIX=message_id,file_name

# Host port for the web UI
WEB_PORT=5000

# Timezone for dated folders, e.g. America/New_York, Europe/London, Asia/Kolkata
TZ=UTC
